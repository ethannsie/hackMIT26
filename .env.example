# Optional hosted extraction for development. Leave unset for the all-GX10 demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# On-device extraction on the GX10. OpenAI-compatible base URL of its
# Ollama. Use localhost when the app runs on the GX10 itself (the intended
# deployment, plan §9); use its LAN IP from a laptop — note venue Wi-Fi blocks
# device-to-device traffic, so from a laptop this only works on a phone hotspot.
EXTRACT_LOCAL_URL=http://localhost:11434/v1
EXTRACT_LOCAL_MODEL=qwen3.8
# Measured ~30 s per photo with qwen3.8. Anything shorter than that means the
# GX10 never gets to answer.
EXTRACT_LOCAL_TIMEOUT_MS=45000

API_PORT=8787

# Text-only jobs on the GX10: writing a new problem (the "New problem" button
# and panel tile) and answering a visitor's question (the Ask box). A model
# whose reasoning Ollama can switch off; measured 5–6 s per problem and ~1.5 s
# per answer with nemotron. Falls back to nothing — these need the local endpoint.
TEXT_LOCAL_MODEL=nemotron-3.5-lightning
TEXT_LOCAL_TIMEOUT_MS=30000

# Speech to text for the Ask box, through Deepgram. Server-side only; the
# browser never sees the key. Leave unset and the box works typed. Needs
# internet at the venue — the typed box does not.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Textbook passages for the Ask box (corpus/README.md). Built on the box.
CORPUS_DIR=./corpus
